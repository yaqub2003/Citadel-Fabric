{
  "schemaVersion": 1,
  "id": "citadel",
  "version": "${version}",
  "name": "Citadel (Fabric)",
  "description": "A shared code library for many of Alexthe666's mods. Code used from LLibrary with permission.\nUnofficial Fabric 1.20.1 port by BluSpring and updated by Yaqub2003.",
  "authors": [
    "Alexthe666",
    "Gegy1000",
    "BluSpring",
    "Yaqub2003"
  ],
  "contact": {
    "sources": "https://github.com/Yaqub2003/Citadel-Fabric"
  },
  "license": "LGPL",
  "icon": "citadel.png",
  "environment": "*",
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric": ">=${fabric_version}",
    "minecraft": "${minecraft_version}",
    "architectury": ">=${architectury_version}",
    "porting_lib": ">=${porting_lib_version}",
    "forgeconfigapiport": ">=${forge_config_version}"
  },
  "custom": {
    "modmenu": {
      "badges": [ "library" ]
    }
  },
  "accessWidener": "citadel.accesswidener",
  "entrypoints": {
    "main": [
      "com.github.alexthe666.citadel.Citadel"
    ]
  },
  "mixins": [
    "citadel.mixins.json"
  ]
}